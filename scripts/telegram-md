#!/usr/bin/env python3
"""telegram-md: turn Markdown into a Telegram-friendly folded viewer.

Default behavior is safe/local: generate a standalone HTML file.
If --host is provided, delegate to send-folded-markdown.py to register/send the artifact.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
GEN = ROOT / "scripts" / "generate-folded-markdown-viewer.py"
SEND = ROOT / "scripts" / "send-folded-markdown.py"


def default_title(path: Path) -> str:
    return path.stem.replace("-", " ").replace("_", " ").title()


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate or send a folded Telegram-friendly Markdown viewer."
    )
    parser.add_argument("markdown", help="Markdown file to render")
    parser.add_argument("--title", help="Viewer title. Defaults to filename-derived title.")
    parser.add_argument("--out", help="Output HTML path. Defaults to /tmp/<name>-telegram-md.html")
    parser.add_argument("--fold-level", type=int, default=2, help="Heading level to fold at, default 2")
    parser.add_argument("--host", help="Public artifact host. If set, registers/sends artifact instead of only generating HTML.")
    parser.add_argument("--chat-id", help="Optional Telegram chat ID for send mode")
    parser.add_argument("--thread-id", help="Optional Telegram thread/topic ID for send mode")
    parser.add_argument("--dry-run", action="store_true", help="In send mode, generate only and print output path")
    args = parser.parse_args()

    md = Path(args.markdown).expanduser().resolve()
    if not md.exists():
        parser.error(f"Markdown file not found: {md}")
    if not md.is_file():
        parser.error(f"Not a file: {md}")

    title = args.title or default_title(md)
    out = Path(args.out).expanduser().resolve() if args.out else Path("/tmp") / f"{md.stem}-telegram-md.html"

    if args.host:
        cmd = [
            sys.executable,
            str(SEND),
            str(md),
            title,
            args.host,
            "--fold-level",
            str(args.fold_level),
            "--keep-html",
            str(out),
        ]
        if args.chat_id:
            cmd.append(args.chat_id)
            if args.thread_id:
                cmd.append(args.thread_id)
        elif args.thread_id:
            parser.error("--thread-id requires --chat-id")
        if args.dry_run:
            cmd.append("--dry-run")
    else:
        cmd = [
            sys.executable,
            str(GEN),
            "--file",
            str(md),
            "--title",
            title,
            "--fold-level",
            str(args.fold_level),
            "--out",
            str(out),
        ]

    subprocess.run(cmd, check=True, stdout=subprocess.DEVNULL if not args.host else None)
    if not args.host:
        print(out)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
